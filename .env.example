# Local application configuration. Copy to .env only if a future local runner uses it.
# Do not commit .env with real values.

# Public: safe to expose to browser clients.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_DEVELOPMENT_PUBLISHABLE_KEY
APP_ORIGIN=https://ideation.teleoflexuous.com

# Secrets: server/Worker runtime only. Never prefix these with VITE_, PUBLIC_, etc.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_DEVELOPMENT_SECRET_KEY
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_WITH_CLERK_WEBHOOK_SIGNING_SECRET
