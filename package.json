{
  "name": "ideation-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private-by-default ideation workbench with portable guest projects and Clerk-backed cloud workspaces.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "start": "npm run dev",
    "test": "node --test server/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.1",
    "@clerk/clerk-js": "^6.25.8",
    "fflate": "^0.8.3",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "esbuild": "^0.28.1",
    "wrangler": "^4.114.0"
  }
}
