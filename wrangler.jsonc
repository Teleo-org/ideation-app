{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideation-workbench",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./build", "binding": "ASSETS" },
  "routes": [
    { "pattern": "ideation.teleoflexuous.com", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://ideation.teleoflexuous.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ideation-workbench", "database_id": "0f2ebdc8-b3f2-4453-b959-fd01c4745c4b", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "ideation-workbench-attachments" }
  ]
}
